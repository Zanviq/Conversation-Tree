# Copy to .env before running `docker compose up`. Replace the values for anything beyond local use.

# PostgreSQL
POSTGRES_USER=conversation_tree
POSTGRES_PASSWORD=change-me
POSTGRES_DB=conversation_tree

# Secret used to sign session cookies (use a long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Set to true when serving over HTTPS
COOKIE_SECURE=false

# Create the demo account (demo / demo1234) with sample conversations on first start
SEED_ON_START=true

# Port the app is exposed on: http://localhost:8080
WEB_PORT=8080

# The Gemini API key is NOT configured here. Each user enters their own key in the app (stored in the browser only).
